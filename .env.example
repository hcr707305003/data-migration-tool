# ============================================================================
# 基础配置 / Basic Configuration
# ============================================================================

# 服务端口 / Server Port
# 默认值: 8080
PORT=8080

# 数据存储目录 / Data Storage Directory  
# 默认值: ./data
DATA_DIR=./data

# 日志存储目录 / Log Storage Directory
# 默认值: ./logs
LOG_DIR=./logs

# 数据源状态检查间隔（秒）/ Data Source Status Check Interval (seconds)
# 默认值: 300 (5分钟)
STATUS_CHECK_INTERVAL=300

# ============================================================================
# 并发配置 / Concurrency Configuration
# ============================================================================

# 最大并发任务数 / Maximum Concurrent Tasks
# 默认值: 3
# 说明: 同时运行的迁移任务数量
MAX_CONCURRENT_TASKS=3

# 每任务最大并发表数 / Maximum Concurrent Tables per Task
# 默认值: 2
# 说明: 每个任务同时迁移的表数量
MAX_CONCURRENT_TABLES=2

# 每表最大并发批次数 / Maximum Concurrent Batches per Table
# 默认值: 4
# 说明: 每个表同时处理的批次数量
MAX_CONCURRENT_BATCHES=4

# ============================================================================
# 性能配置 / Performance Configuration
# ============================================================================

# 默认批处理大小 / Default Batch Size
# 默认值: 1000
# 说明: 每次处理的记录数量，影响内存使用和性能
DEFAULT_BATCH_SIZE=1000

# 连接超时时间（秒）/ Connection Timeout (seconds)
# 默认值: 30
CONNECTION_TIMEOUT=30

# 查询超时时间（秒）/ Query Timeout (seconds)
# 默认值: 300
QUERY_TIMEOUT=300