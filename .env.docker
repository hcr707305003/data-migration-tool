# Docker环境配置示例
# 复制此文件为 .env 并根据需要修改

# Web服务配置
PORT=8080

# 数据目录
DATA_DIR=/app/data
LOG_DIR=/app/logs

# 并发配置
MAX_CONCURRENT_TASKS=3
MAX_CONCURRENT_TABLES=2
MAX_CONCURRENT_BATCH=4

# 性能配置
DEFAULT_BATCH_SIZE=1000
CONNECTION_TIMEOUT=30
QUERY_TIMEOUT=300

# 状态检查间隔（秒）
STATUS_CHECK_INTERVAL=300

# 数据库连接示例（根据实际情况修改）
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=testuser
# DB_PASSWORD=testpassword